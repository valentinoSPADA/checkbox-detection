# Everything here is optional. The service ships with no credentials of any kind and its
# defaults are the measured ones, so `docker compose up --build` works on a clean clone with
# no .env file at all. Copy this only to change something.

# Confidence floor applied to every response. Measured, not guessed: see DefaultPolicy in
# backend/internal/domain/policy.go for the threshold sweep behind 0.90. It belongs to the
# trained model rather than to the problem, so it is re-swept after any retrain.
MIN_CONFIDENCE=0.90

# Engine used when a request does not name one. One engine ships; GET /engines reports what
# a given build actually registers.
DEFAULT_ENGINE=local

# Address the browser uses to reach the API. Must be host-visible, not compose-internal.
PUBLIC_API_URL=http://localhost:8080

# --- Upload limits -----------------------------------------------------------------------
# Two limits, at two layers, because neither can do the other's job.
#
# MAX_UPLOAD_BYTES is enforced by the Go gateway before the body is buffered. It bounds what
# arrives. It cannot bound what the image COSTS, because compression ratio is chosen by
# whoever sends the file.
MAX_UPLOAD_BYTES=26214400

# MAX_IMAGE_PIXELS and MIN_IMAGE_SIDE are enforced by the Python sidecar, at the one place
# decoding happens. 40 MP admits a 600 dpi scan of US Letter (33.7 MP) while refusing the
# decompression bombs a byte limit alone lets through; the sample pages are 10.7 MP.
MAX_IMAGE_PIXELS=40000000
MIN_IMAGE_SIDE=32

LOG_LEVEL=info
