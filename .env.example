# Copy to .env and fill in to enable the Claude-backed engines.
# The system runs fully without this file: the local engine needs no credentials and is the
# default, so `docker compose up --build` works on a clean clone with nothing configured.

# Enables the `vlm` and `assisted` engines. Without it they are not registered at all, and
# GET /engines reports only `local`.
ANTHROPIC_API_KEY=

# Vision model used by those engines.
ANTHROPIC_MODEL=claude-opus-5

# Engine used when a request does not name one. Setting this to anything but `local`
# requires ANTHROPIC_API_KEY and is refused at startup otherwise.
DEFAULT_ENGINE=local

# Confidence floor applied to every response. See DESIGN.md section 5 for why 0.60.
MIN_CONFIDENCE=0.60

# Address the browser uses to reach the API. Must be host-visible, not compose-internal.
PUBLIC_API_URL=http://localhost:8080

LOG_LEVEL=info
