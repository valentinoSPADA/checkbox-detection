# Copy to .env and fill in to enable the Claude-backed engines.
# The system runs fully without this file: the local engine needs no credentials and is the
# default, so `docker compose up --build` works on a clean clone with nothing configured.

# Enables the `vlm` and `assisted` engines. Without it they are not registered at all, and
# GET /engines reports only `local`.
ANTHROPIC_API_KEY=

# Vision model used by those engines.
ANTHROPIC_MODEL=claude-haiku-4-5

# Engine used when a request does not name one. Setting this to anything but `local`
# requires ANTHROPIC_API_KEY and is refused at startup otherwise.
DEFAULT_ENGINE=local

# Confidence floor applied to every response. Measured, not guessed: see DefaultPolicy in
# backend/internal/domain/policy.go for the threshold sweep behind 0.95.
MIN_CONFIDENCE=0.95

# Address the browser uses to reach the API. Must be host-visible, not compose-internal.
PUBLIC_API_URL=http://localhost:8080

# How many uncertain candidates one request may escalate to Claude, and how many crops go
# into each call. The band holds 57-448 candidates depending on the page, so the cap decides
# how much of a hard page actually gets a second opinion; at the old value of 40 the
# watermarked sample got 9% coverage and assisted output was nearly identical to local.
MAX_ESCALATIONS=120
VLM_BATCH_SIZE=20

LOG_LEVEL=info
