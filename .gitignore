# Build output
backend/api
backend/api.exe
backend/coverage.out
frontend/dist/
frontend/coverage/
detector/htmlcov/
detector/coverage.xml
detector/.coverage

# Dependencies
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/

# Secrets. The API key enables the paid engines; it must never be committed.
.env
.env.local

# Local artefacts produced by the eval harness
eval/out/
docs/overlays/

# Seeded design-canvas output: a ~2.3 MB build artifact regenerated from the working files
# in design/ (Main.dc.html, canvas.json, form-crop.jpg), which are the actual source.
design/*.html
!design/*.dc.html

# Generated hand-labelling page: 13.5 MB of base64 crops, rebuilt in seconds by
# `python -m training.make_labeling_task`. The labels it produced ARE committed
# (data/labels_human.json) -- those cost a person an hour and cannot be regenerated.
detector/data/label.html
